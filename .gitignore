# ==============================================================================
# FoundIt — Git Ignore Rules
# ==============================================================================

# Node dependencies
node_modules/
.pnp
.pnp.js

# Production build artifacts
dist/
build/
out/

# Environment files and credentials (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Preserve .env.example
!.env.example

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage reports
coverage/
.nyc_output/

# Editor and Operating System artifacts
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Caches and temporary directories
.cache/
.parcel-cache/
.eslintcache
tmp/
temp/

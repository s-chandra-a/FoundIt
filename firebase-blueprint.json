{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "University student or administrator account profile with isolated PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "description": "University email address."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Full name of the student or staff member."
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "University department or faculty."
        },
        "studentId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "University ID number."
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"],
          "description": "Account role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of registration."
        }
      },
      "required": ["uid", "email", "displayName", "department", "studentId", "role", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin user UID."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when admin privilege was granted."
        },
        "bootstrapKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 64,
          "description": "Verification token for pre-provisioned campus admin."
        }
      },
      "required": ["uid", "grantedAt", "bootstrapKey"]
    },
    "CampusItem": {
      "title": "CampusItem",
      "description": "A lost or found item record in the campus directory with a 64-bit perceptual image hash.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique item identifier."
        },
        "type": {
          "type": "string",
          "enum": ["found", "lost"],
          "description": "Whether the item was found on campus or reported lost."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Concise title of the item."
        },
        "category": {
          "type": "string",
          "enum": ["Electronics", "ID & Keys", "Accessories", "Books & Notes", "Apparel", "Bottles & Gear", "Other"],
          "description": "Item category."
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Campus building or room where the item was lost or found."
        },
        "dateOccurred": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "description": "Date when the item was lost or found."
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1000,
          "description": "Detailed description of the item."
        },
        "imageDataUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 150000,
          "description": "Compressed image data URI for visual preview."
        },
        "imageHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9a-fA-F]+$",
          "description": "Perceptual image hash in hexadecimal format for similarity comparison."
        },
        "status": {
          "type": "string",
          "enum": ["pending_approval", "approved", "claimed", "resolved", "rejected"],
          "description": "Current moderation and claim lifecycle status."
        },
        "reporterId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the student or admin who submitted the item."
        },
        "reporterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the reporter."
        },
        "visibility": {
          "type": "string",
          "enum": ["campus"],
          "description": "Scope of visibility for campus directory queries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "category",
        "location",
        "dateOccurred",
        "description",
        "imageDataUrl",
        "imageHash",
        "status",
        "reporterId",
        "reporterName",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ItemClaim": {
      "title": "ItemClaim",
      "description": "A claim submitted by a student for a found item.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique claim ID."
        },
        "itemId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced found item ID."
        },
        "itemTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Title of the claimed item."
        },
        "claimantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the student claiming the item."
        },
        "claimantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the student claiming the item."
        },
        "proofDescription": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "description": "Ownership proof details provided by the student."
        },
        "matchScore": {
          "type": "number",
          "description": "Perceptual image hash similarity percentage (0-100)."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Verification status managed by campus admin."
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 500,
          "description": "Feedback or pickup instructions from the administrator."
        },
        "visibility": {
          "type": "string",
          "enum": ["campus"],
          "description": "Scope of visibility for campus claim moderation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "itemId",
        "itemTitle",
        "claimantId",
        "claimantName",
        "proofDescription",
        "matchScore",
        "status",
        "adminNotes",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student and administrator profile records with PII isolated to owner and admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Administrator registry for RBAC lookups."
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/CampusItem" },
      "description": "Lost and found items registered in the campus directory."
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/ItemClaim" },
      "description": "Ownership claims submitted by students for found items."
    }
  }
}
